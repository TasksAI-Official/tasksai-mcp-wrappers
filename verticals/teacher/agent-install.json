{
  "schema_version": "1.0",
  "product_id": "teacher",
  "product_name": "TeacherTasksAI",
  "official_domain": "teachertasksai.com",
  "official_github_repo": "https://github.com/TasksAI-Official/tasksai-mcp-wrappers",
  "official_package": "@tasksai/install",
  "installer": {
    "preferred": "npm_exec",
    "npm_exec": {
      "command": "npm",
      "args": [
        "exec",
        "--package=@tasksai/install@0.1.47",
        "--call",
        "tasksai-install teacher --source https://github.com/TasksAI-Official/tasksai-mcp-wrappers/tree/main/verticals/teacher"
      ],
      "requires": [
        "node",
        "npm"
      ]
    }
  },
  "supported_clients": [
    "claude-desktop",
    "cursor",
    "windsurf",
    "codex"
  ],
  "permissions": {
    "write_paths": {
      "macos": [
        "~/Library/Application Support/TasksAI/teacher",
        "~/Library/Application Support/Claude/claude_desktop_config.json",
        "~/.cursor/mcp.json",
        "~/.codeium/windsurf/mcp_config.json",
        "~/.codex/config.toml"
      ],
      "windows": [
        "%LOCALAPPDATA%\\TasksAI\\teacher",
        "%APPDATA%\\Claude\\claude_desktop_config.json",
        "%USERPROFILE%\\.cursor\\mcp.json",
        "%USERPROFILE%\\.codeium\\windsurf\\mcp_config.json",
        "%USERPROFILE%\\.codex\\config.toml"
      ],
      "linux": [
        "~/.local/share/TasksAI/teacher",
        "~/.config/Claude/claude_desktop_config.json",
        "~/.cursor/mcp.json",
        "~/.codeium/windsurf/mcp_config.json",
        "~/.codex/config.toml"
      ]
    },
    "environment_overrides": [
      "TASKSAI_INSTALL_DIR"
    ],
    "notes": "TASKSAI_INSTALL_DIR or --install-dir may point to an exact alternate product install directory in restricted agent environments."
  },
  "auth": {
    "method": "browser_device_flow",
    "connect_url": "https://teachertasksai.com/connect",
    "fallback": "license_key"
  },
  "security": {
    "require_domain_verification": true,
    "require_repo_verification": true,
    "disallow_arbitrary_manifest_commands": true,
    "native_installer_user_approval_required": true
  },
  "health_check": {
    "command": "npm",
      "args": [
        "exec",
        "--package=@tasksai/install@0.1.47",
        "--call",
        "tasksai-install teacher doctor"
      ]
  },
  "post_install": {
    "run_health_check": true,
    "health_check_client": "same_as_install",
    "restart_client": true,
    "first_file_prompt": "Write a daily lesson plan and save the finished plan as a local Word document."
  },
  "uninstall": {
    "command": "npm",
      "args": [
        "exec",
        "--package=@tasksai/install@0.1.47",
        "--call",
        "tasksai-install teacher uninstall"
    ]
  },
  "support": {
    "url": "https://teachertasksai.com/support",
    "email": "support@teachertasksai.com"
  },
  "runtime": {
    "source": "shared_installer",
    "notes": "The wrapper repo provides product metadata; @tasksai/install supplies the shared MCP runtime."
  },
  "official_manifest_path": "verticals/teacher/agent-install.json",
  "official_source_url": "https://github.com/TasksAI-Official/tasksai-mcp-wrappers/tree/main/verticals/teacher",
  "local_workspace": true,
  "agent_setup": {
    "instructions_file": "AGENT-SETUP.md",
    "requires": "Command execution on the customer's actual computer and write access to the selected client configuration; a remote sandbox alone is insufficient.",
    "node_missing": "Use the verified packaged native launcher below instead of asking the customer to install Node manually.",
    "native_bootstrap": {
      "package_version": "0.1.47",
      "archive_url": "https://registry.npmjs.org/@tasksai/install/-/install-0.1.47.tgz",
      "archive_sha256": "61867110296b19efa6b4487c0ef930db53b2941b009ae3b38250218e92a447c5",
      "macos": "package/bootstrap/Install TeacherTasksAI.command",
      "windows": "package/bootstrap/Install TeacherTasksAI.ps1",
      "requires_complete_package": true,
      "customer_download_journey_validated": false
    }
  }
}
