{
  "schema_version": "1.0",
  "product_id": "realtor",
  "product_name": "RealtorTasksAI",
  "official_domain": "realtortasksai.com",
  "official_github_repo": "https://github.com/TasksAI-Official/tasksai-mcp-wrappers",
  "official_package": "@tasksai/install",
  "installer": {
    "preferred": "npm_exec",
    "npm_exec": {
      "command": "npm",
      "args": [
        "exec",
        "--package=@tasksai/install@0.1.48",
        "--call",
        "tasksai-install realtor --source https://github.com/TasksAI-Official/tasksai-mcp-wrappers/tree/main/verticals/realtor"
      ],
      "requires": [
        "node",
        "npm"
      ]
    }
  },
  "supported_clients": [
    "claude-desktop",
    "cursor",
    "windsurf",
    "codex",
    "gemini",
    "antigravity"
  ],
  "permissions": {
    "write_paths": {
      "macos": [
        "~/Library/Application Support/TasksAI/realtor",
        "~/Library/Application Support/Claude/claude_desktop_config.json",
        "~/.cursor/mcp.json",
        "~/.codeium/windsurf/mcp_config.json",
        "~/.codex/config.toml",
        "~/.gemini/settings.json",
        "~/.gemini/config/mcp_config.json"
      ],
      "windows": [
        "%LOCALAPPDATA%\\TasksAI\\realtor",
        "%APPDATA%\\Claude\\claude_desktop_config.json",
        "%USERPROFILE%\\.cursor\\mcp.json",
        "%USERPROFILE%\\.codeium\\windsurf\\mcp_config.json",
        "%USERPROFILE%\\.codex\\config.toml",
        "%USERPROFILE%\\.gemini\\settings.json",
        "%USERPROFILE%\\.gemini\\config\\mcp_config.json"
      ],
      "linux": [
        "~/.local/share/TasksAI/realtor",
        "~/.config/Claude/claude_desktop_config.json",
        "~/.cursor/mcp.json",
        "~/.codeium/windsurf/mcp_config.json",
        "~/.codex/config.toml",
        "~/.gemini/settings.json",
        "~/.gemini/config/mcp_config.json"
      ]
    },
    "environment_overrides": [
      "TASKSAI_INSTALL_DIR"
    ],
    "notes": "TASKSAI_INSTALL_DIR or --install-dir may point to an exact alternate product install directory in restricted agent environments."
  },
  "auth": {
    "method": "browser_device_flow",
    "connect_url": "https://realtortasksai.com/connect",
    "fallback": "license_key"
  },
  "security": {
    "require_domain_verification": true,
    "require_repo_verification": true,
    "disallow_arbitrary_manifest_commands": true,
    "native_installer_user_approval_required": true
  },
  "health_check": {
    "command": "npm",
    "args": [
      "exec",
      "--package=@tasksai/install@0.1.48",
      "--call",
      "tasksai-install realtor doctor"
    ]
  },
  "post_install": {
    "run_health_check": true,
    "health_check_client": "same_as_install",
    "restart_client": true,
    "first_file_prompt": "Help me create an open-house buyer follow-up email from my showing notes. Ask me for the property, the buyer's stated priorities, and the next step, then save the finished draft as a local Word document."
  },
  "uninstall": {
    "command": "npm",
    "args": [
      "exec",
      "--package=@tasksai/install@0.1.48",
      "--call",
      "tasksai-install realtor uninstall"
    ]
  },
  "support": {
    "url": "https://realtortasksai.com/support",
    "email": "hello@realtortasksai.com"
  },
  "runtime": {
    "source": "shared_installer",
    "notes": "The wrapper repo provides product metadata; @tasksai/install supplies the shared MCP runtime."
  },
  "official_manifest_path": "verticals/realtor/agent-install.json",
  "official_source_url": "https://github.com/TasksAI-Official/tasksai-mcp-wrappers/tree/main/verticals/realtor",
  "local_workspace": true,
  "agent_setup": {
    "instructions_file": "AGENT-SETUP.md",
    "requires": "Command execution on the customer's actual computer and write access to the selected client configuration; a remote sandbox alone is insufficient.",
    "node_missing": "Use the verified packaged native launcher below instead of asking the customer to install Node manually.",
    "native_bootstrap": {
      "package_version": "0.1.48",
      "archive_url": "https://registry.npmjs.org/@tasksai/install/-/install-0.1.48.tgz",
      "archive_sha256": "afd689a830500c6cf03178a8b31cf9e6b73e4fec247387875373e05a2c5c90f3",
      "macos": "package/bootstrap/Install RealtorTasksAI.command",
      "windows": "package/bootstrap/Install RealtorTasksAI.ps1",
      "requires_complete_package": true,
      "customer_download_journey_validated": false
    }
  }
}
